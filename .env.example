# ==================================================
# AutoTest DPRH — Variables de entorno (ejemplo)
# Copiar este archivo como ".env" y ajustar valores.
# NUNCA subir el archivo ".env" real al repositorio.
# ==================================================

# --- General ---
APP_NAME=AutoTest DPRH
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# --- Base de datos PostgreSQL ---
POSTGRES_USER=autotest_user
POSTGRES_PASSWORD=autotest_pass
POSTGRES_DB=autotest_dprh
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Cadena de conexion usada por SQLAlchemy/Alembic (backend)
DATABASE_URL=postgresql+psycopg://autotest_user:autotest_pass@db:5432/autotest_dprh

# --- Seguridad / JWT ---
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# Vigencia maxima del token de un evaluado en el portal (Fase 7).
# Nunca excede la fecha de expiracion propia de su acceso temporal.
EVALUADO_TOKEN_EXPIRE_MINUTES=180

# --- CORS (separado por comas) ---
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend ---
VITE_API_BASE_URL=/api
